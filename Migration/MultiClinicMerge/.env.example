# =============================================================================
# Helianz Cloud / Hybrid Media Migration Configuration (Template)
# Copy this file to .env and adjust values for your environment.
# NEVER commit real credentials to version control.
# =============================================================================

# S3 / iDrive e2 Storage Configuration
S3_PROVIDER=IDrive
S3_ENDPOINT=s3.ap-northeast-1.idrivee2.com
S3_REGION=ap-northeast-1
S3_BUCKET=dsmile
S3_ACCESS_KEY=YOUR_S3_ACCESS_KEY_HERE
S3_SECRET_KEY=YOUR_S3_SECRET_KEY_HERE
S3_FORCE_PATH_STYLE=true
S3_ACL=private

# Rclone Remote Profile Name (created on the fly)
RCLONE_REMOTE_NAME=helianz-media

# Default Storage Paths
DEFAULT_REMOTE=helianz-media:dsmile/HelianzImages
# DEFAULT_DEST=helianz-media:dsmile/HelianzImagesNew

# MariaDB / MySQL Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=YOUR_MYSQL_PASSWORD_HERE
MYSQL_DATABASE=helianz
